generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String?     @unique
  role              String
  position          String
  pin               String      @default("0000")

  signatures        Signature[] @relation("ApproverSignatures")
  managedSignatures Signature[] @relation("TeacherSignatures")
}

model Signature {
  id         String   @id @default(cuid())
  teacherId  String
  approverId String
  note       String?

  teacher    User     @relation("TeacherSignatures", fields: [teacherId], references: [id], onDelete: Cascade)
  approver   User     @relation("ApproverSignatures", fields: [approverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([teacherId, approverId])
  @@index([teacherId])
  @@index([approverId])
}

model Classroom {
  id           String   @id @default(cuid())
  grade        Int
  section      String   // "А", "Б", "В" ...
  label        String   // "2А анги"
  headTeacher  String
  room         String?
  capacity     Int      @default(32)
  studentCount Int      @default(0)
  status       String   @default("official") // "official" | "draft"

  students     Student[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([grade, section])
  @@index([grade])
}

model Student {
  id          String   @id @default(cuid())
  code        String   @unique // "2А-001" etc.
  firstName   String
  lastName    String
  gender      String   // "M" | "F"
  attendance  Int      @default(95) // percentage
  gpa         Float    @default(3.5)
  // Marked by admin: these kids should get pulled in to any newly-formed section first
  // (used by createSectionFromPool when preferChosen is on — surfaces "random" picks
  // that happen to include children of specific parents).
  chosen      Boolean  @default(false)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  // Last known previous classroom, populated when a student is moved by a shuffle.
  // Used by revertSection() to send everyone back to where they came from.
  previousClassroomId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classroomId])
  @@index([chosen])
  @@index([lastName, firstName])
}

model Announcement {
  id     String @id @default(cuid())
  text   String
  order  Int    @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsItem {
  id      String   @id @default(cuid())
  tag     String
  title   String
  excerpt String
  date    DateTime @default(now())
  order   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourRoom {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  subtitle    String
  description String
  icon        String // lucide icon name
  panoramaUrl String? // 360° equirectangular image URL
  order       Int     @default(0)

  facts       TourRoomFact[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TourRoomFact {
  id     String   @id @default(cuid())
  key    String
  value  String
  roomId String
  order  Int      @default(0)

  room   TourRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model SchoolInfo {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  url       String
  alt       String?
  category  String   @default("general")
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        String   @id @default(cuid())
  name      String
  grade     String?
  award     String
  year      Int
  category  String   @default("olimpiad")
  image     String?
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  time      String?
  location  String?
  description String
  type      String   @default("school")
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  text      String
  rating    Int      @default(5)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(cuid())
  name        String
  description String
  teacher     String?
  schedule    String?
  icon        String?
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("new") // "new" | "read" | "resolved"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

