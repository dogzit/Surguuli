// COPY of the shared database schema. The source of truth is the staff site
// (github.com/dogzit/Surguuli-staff): schema changes and `db push` happen
// there, then this file is replaced with that one unchanged. Do not edit here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String?     @unique
  role              String
  position          String
  pin               String      @default("0000")

  signatures        Signature[] @relation("ApproverSignatures")
  managedSignatures Signature[] @relation("TeacherSignatures")
}

model Signature {
  id         String   @id @default(cuid())
  teacherId  String
  approverId String
  note       String?

  teacher    User     @relation("TeacherSignatures", fields: [teacherId], references: [id], onDelete: Cascade)
  approver   User     @relation("ApproverSignatures", fields: [approverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([teacherId, approverId])
  @@index([teacherId])
  @@index([approverId])
}

model Classroom {
  id           String   @id @default(cuid())
  grade        Int
  section      String   // "А", "Б", "В" ...
  label        String   // "2А анги"
  headTeacher  String
  room         String?
  capacity     Int      @default(32)
  studentCount Int      @default(0)
  status       String   @default("official") // "official" | "draft"

  students     Student[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([grade, section])
  @@index([grade])
}

model Student {
  id          String   @id @default(cuid())
  code        String   @unique // "2А-001" etc.
  firstName   String
  lastName    String
  gender      String   // "M" | "F"
  attendance  Int      @default(95) // percentage
  gpa         Float    @default(3.5)
  // Marked by admin: these kids should get pulled in to any newly-formed section first
  // (used by createSectionFromPool when preferChosen is on — surfaces "random" picks
  // that happen to include children of specific parents).
  chosen      Boolean  @default(false)

  // ── Auth fields (Week 1 launch) ─────────────────────────────
  // Student login is opt-in per student. Admin bulk-generates PINs and
  // hands out per-classroom sheets; students can update their own PIN
  // and email later. Nullable so pre-existing rows keep working until
  // an admin runs the generation script.
  pin         String?
  email       String?  @unique
  loginAt     DateTime?

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  // Last known previous classroom, populated when a student is moved by a shuffle.
  // Used by revertSection() to send everyone back to where they came from.
  previousClassroomId String?

  applications  UniversityApplication[]
  parentLinks   ParentStudent[]
  inviteCodes   InviteCode[]
  portfolio     StudentPortfolioItem[]
  clubMembers   ClubMember[]
  lateArrivals  LateArrival[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classroomId])
  @@index([chosen])
  @@index([lastName, firstName])
}

// Parent / guardian account. One parent can be linked to multiple
// students (siblings) via ParentStudent, and one student can have
// multiple parents (both bio parents, guardian, etc.).
//
// Parents self-register using an InviteCode generated by an admin.
// They then sign in with email + PIN. Password reset lives on the
// admin panel until email flow is wired in Week 4.
model Parent {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  pin       String   // bcrypt
  phone     String?
  loginAt   DateTime?

  children  ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table between Parent and Student. `relation` is free text
// (mother, father, guardian, etc.) so the school isn't forced into
// a fixed enum before we know the shape of real families.
model ParentStudent {
  id         String   @id @default(cuid())
  parentId   String
  studentId  String
  relation   String?  // "Ээж", "Аав", "Хамгаалагч", …

  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

// One-time (or few-time) codes an admin generates to onboard a parent.
// The parent redeems the code by filling in name + email + phone + PIN;
// on success we create a Parent row and a ParentStudent link. Codes
// expire after a configurable window and are single-use by default.
model InviteCode {
  id         String   @id @default(cuid())
  code       String   @unique // human-shareable 8-char, upper-alnum
  studentId  String
  relation   String?  // suggested "Ээж"/"Аав" the admin selected
  createdById String?
  usedAt     DateTime?
  usedById   String?  // Parent.id after redemption
  expiresAt  DateTime?

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([expiresAt])
}

// One record per (student, target university) tuple. Groups the several
// document requests that a single university application requires.
// Kept intentionally free-form on `university` and `country` — this is
// operations tracking, not an academic institution registry.
model UniversityApplication {
  id           String   @id @default(cuid())
  studentId    String
  university   String   // "MIT", "University of Tokyo", "Common App"
  country      String?  // "USA", "UK", "JP" — free text ISO-ish
  program      String?  // "Computer Science", optional
  deadline     DateTime?
  status       String   @default("open") // "open" | "submitted" | "complete" | "cancelled"
  notes        String?

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents    DocumentRequest[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([status, deadline])
}

// Single document within an application (e.g. official transcript,
// counselor recommendation). `type` is validated in code against the
// list in `lib/documents.ts`. `fileUrl` is either an uploaded PDF link
// or an auto-generated one — the workflow doesn't care which.
model DocumentRequest {
  id            String   @id @default(cuid())
  applicationId String
  type          String   // see DOCUMENT_TYPES in lib/documents.ts
  status        String   @default("pending") // "pending" | "in_progress" | "ready" | "delivered"
  fileUrl       String?
  note          String?
  assignedToId  String?  // optional user (teacher/counselor) responsible

  application   UniversityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, type])
  @@index([applicationId])
  @@index([status])
  @@index([assignedToId])
}

model Announcement {
  id     String @id @default(cuid())
  text   String
  order  Int    @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsItem {
  id           String   @id @default(cuid())
  tag          String
  title        String
  excerpt      String
  // Optional rich HTML body — sanitized on write. When null, we render
  // just the excerpt on the detail page.
  body         String?
  coverImage   String?
  // URL-friendly slug for /news/[slug]. Unique so the DB rejects
  // collisions before the request hits our handler. Backfilled from
  // title when null.
  slug         String?  @unique
  status       String   @default("published") // "draft" | "published"
  publishedAt  DateTime?
  date         DateTime @default(now())
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, publishedAt])
}

model TourRoom {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  subtitle    String
  description String
  icon        String // lucide icon name

  // Three optional media sources. The viewer picks the best one available:
  //   1. panoramaUrl — true equirectangular 360 (Insta360/GoPro Max/Ricoh Theta)
  //   2. videoUrl    — regular MP4/WebM walkthrough (drone or phone footage)
  //   3. photoUrl    — single large photo (iPhone Pano, drone still)
  // If all are null, the interactive CSS-3D fallback shows.
  panoramaUrl String?
  videoUrl    String?
  photoUrl    String?

  order       Int     @default(0)

  facts       TourRoomFact[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TourRoomFact {
  id     String   @id @default(cuid())
  key    String
  value  String
  roomId String
  order  Int      @default(0)

  room   TourRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model SchoolInfo {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  url       String
  alt       String?
  category  String   @default("general")
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        String   @id @default(cuid())
  name      String
  grade     String?
  award     String
  year      Int
  category  String   @default("olimpiad")
  // Kept for backwards compat — treated as the "cover" image. Additional
  // images go in the AchievementImage 1:N table below.
  image     String?
  order     Int      @default(0)

  photos    AchievementImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Extra photos attached to an Achievement (photo galleries per medal
// win). Ordering is manual via `order`. Deleting the parent achievement
// cascades so orphan images can't stick around.
model AchievementImage {
  id            String   @id @default(cuid())
  achievementId String
  url           String
  caption       String?
  order         Int      @default(0)

  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([achievementId])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  time      String?
  location  String?
  description String
  type      String   @default("school")
  order     Int      @default(0)

  rsvps     EventRsvp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  text      String
  rating    Int      @default(5)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(cuid())
  name        String
  description String
  teacher     String?
  schedule    String?
  icon        String?
  order       Int      @default(0)

  members     ClubMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("new") // "new" | "read" | "resolved"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// A student arriving late, recorded by the teacher on gate duty that day
// (/dashboard/duty). `date` is the school-day key in Asia/Ulaanbaatar
// ("YYYY-MM-DD") so day boundaries never drift with the server's UTC clock.
// Only some grades are in the Student table, so the name and class are typed
// by the duty teacher and stored as text; `studentId` is linked when the
// teacher picks a matching student. One row per student per day. The social
// worker reviews the aggregate in /dashboard/admin/lateness.
model LateArrival {
  id             String   @id @default(cuid())
  date           String   // "YYYY-MM-DD", Asia/Ulaanbaatar
  studentName    String
  classLabel     String   // normalised, e.g. "5Б" (see normalizeClassLabel)
  minutesLate    Int
  comesFrom      String   // where the student comes from, e.g. "13-р хороо"
  studentId      String?
  recordedById   String?  // User.id; null when recorded with the admin PIN only
  recordedByName String   // snapshot, survives the user being deleted

  student        Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([classLabel, date])
}

// Feedback & suggestions box (/feedback). Anyone may submit; signed-in
// senders are linked via the polymorphic actor pair below unless they tick
// "anonymous", in which case no identity, name or contact is stored at all.
// Admins triage in /dashboard/admin/feedback and may write a `response`,
// which the linked sender sees on /feedback and gets notified about.
model Feedback {
  id          String    @id @default(cuid())
  kind        String    @default("suggestion") // "suggestion" | "request" | "complaint" | "praise"
  topic       String    @default("other")      // see FEEDBACK_TOPICS in lib/feedback.ts
  title       String?
  body        String
  anonymous   Boolean   @default(false)
  actorKind   String?   // "student" | "parent" | "user" — null when anonymous/logged out
  actorId     String?
  name        String?   // display name snapshot; null when anonymous
  contact     String?   // optional email/phone for a reply; null when anonymous
  status      String    @default("new")        // "new" | "in_review" | "resolved" | "archived"
  adminNote   String?   // internal, never shown to the sender
  response    String?   // reply shown to a linked sender
  respondedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([actorKind, actorId, createdAt])
}

// ── Community layer (Week 3) ─────────────────────────────────
//
// The models below use a "polymorphic actor" pattern: instead of a
// foreign key to a specific table, we store `actorType` (one of
// "student" | "parent" | "user") + `actorId` and validate the pair
// in server actions. This lets us reuse a single table (Bookmark,
// EventRsvp, NewsReaction) across all three account kinds without
// dragging Prisma into a union schema.

// A student's own submitted achievement — needs admin approval before
// it goes into the public gallery.
model StudentPortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  category    String   @default("achievement") // "achievement" | "project" | "certificate" | "other"
  description String?
  imageUrl    String?
  achievedAt  DateTime?
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedById String? // user id who moderated
  publishedToGallery Boolean @default(false)

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([status, createdAt])
}

// Membership between a Student and a Club. Auto-approved for now —
// switchable to "pending" review later without a schema change.
model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  studentId String
  status    String   @default("approved") // "pending" | "approved" | "left"
  joinedAt  DateTime @default(now())

  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
  @@index([studentId])
  @@index([clubId])
}

// Polymorphic RSVP for events. Anyone (student, parent, staff) can
// indicate going / interested / no.
model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  actorKind String   // "student" | "parent" | "user"
  actorId   String
  status    String   @default("going") // "going" | "interested" | "no"

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, actorKind, actorId])
  @@index([actorKind, actorId])
}

// Polymorphic bookmark. `targetKind` picks which table to look at when
// rendering the user's saved-items list (news for now; achievement + event
// can join later without a migration).
model Bookmark {
  id         String   @id @default(cuid())
  actorKind  String   // "student" | "parent" | "user"
  actorId    String
  targetKind String   // "news" | "achievement" | "event"
  targetId   String

  createdAt  DateTime @default(now())

  @@unique([actorKind, actorId, targetKind, targetId])
  @@index([actorKind, actorId, createdAt])
  @@index([targetKind, targetId])
}

// Polymorphic reaction (heart / clap). One reaction of a given kind
// per actor per news item — flipping the same kind removes it.
model NewsReaction {
  id         String   @id @default(cuid())
  newsItemId String
  actorKind  String   // "student" | "parent" | "user"
  actorId    String
  kind       String   // "heart" | "clap"

  createdAt  DateTime @default(now())

  @@unique([newsItemId, actorKind, actorId, kind])
  @@index([newsItemId, kind])
}

// Short-lived one-time codes for email verification. Any actor
// (staff / student / parent) can request one; a bcrypt-hashed 6-digit
// code is emailed and must be redeemed within `expiresAt`. `attempts`
// caps brute-force at 5 tries per issued code.
model EmailVerification {
  id         String   @id @default(cuid())
  actorKind  String   // "student" | "parent" | "user"
  actorId    String
  email      String   // the target address (what we'll set on success)
  codeHash   String   // bcrypt of the 6-digit code
  attempts   Int      @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime

  createdAt  DateTime @default(now())

  @@index([actorKind, actorId, verifiedAt])
  @@index([expiresAt])
}

// In-app notification pushed to a specific actor. Rendered in the
// notification bell + optionally emailed by lib/mail.ts. `href` gives
// the click-through target; `data` is a JSON-encoded blob for icons
// or extra context (kept as string to avoid a JSON column requirement).
model InAppNotification {
  id         String    @id @default(cuid())
  actorKind  String    // "student" | "parent" | "user"
  actorId    String
  category   String    // "news" | "portfolio" | "invite" | "event" | "system"
  title      String
  body       String?
  href       String?
  data       String?
  readAt     DateTime?

  createdAt  DateTime  @default(now())

  @@index([actorKind, actorId, readAt])
  @@index([actorKind, actorId, createdAt])
}

// Immutable append-only audit trail for destructive admin actions
// (user delete, PIN regeneration, signature clears, classroom deletes, etc.).
// actorId is null when the action was performed with just the admin PIN
// cookie (no user session). Metadata is a JSON-encoded string of arbitrary
// context — kept as `String` so we don't need a JSON column on every DB.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

